# Copy to .env.local for local builds, or set these in Vercel / Cloudflare Pages
# (Project Settings > Environment Variables). They are read at BUILD time and baked into
# the static HTML, so redeploy after changing one. None of them is secret.
# Leave any unset and the page shows its [[PLACEHOLDER]] instead.

# Public contact email (footer, schema, thank-you page)
NEXT_PUBLIC_EMAIL=hello@example.com

# Demo line answered by the AI. Display format, then E.164 for tel: links.
# 555-01xx numbers are reserved for fiction: safe for testing.
NEXT_PUBLIC_DEMO_PHONE_DISPLAY=(555) 010-0123
NEXT_PUBLIC_DEMO_PHONE_E164=+15550100123

# GoHighLevel
NEXT_PUBLIC_GHL_ORDER_FORM_URL=https://example.com/order
NEXT_PUBLIC_GHL_ONBOARDING_FORM_URL=https://example.com/onboarding
# Leave unset to keep the chat widget off. A fake ID loads a widget that won't work.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# Shown as "Live in ..." and on the thank-you page
NEXT_PUBLIC_GO_LIVE=1 to 2 business days

# Optional: Google Tag Manager container. Empty = GTM off.
NEXT_PUBLIC_GTM_ID=

# Optional: overrides the canonical/OG/sitemap domain. Set it to your test URL
# (e.g. https://your-project.vercel.app) on a test deployment so share previews work there.
# Leave unset in production.
NEXT_PUBLIC_SITE_URL=

# Build gate: 1 lets a build finish while [[PLACEHOLDERS]] remain (the billing FAQ answers and the
# privacy/terms text live in code, so test builds need this). Never set it on production.
ALLOW_PLACEHOLDERS=1
